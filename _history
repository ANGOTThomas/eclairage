n): number {\n        let duration = 0;\n        let RangeInInches = 0;\n\n        pins.digitalWritePin(pin, 0);\n        control.waitMicros(2);\n        pins.digitalWritePin(pin, 1);\n        control.waitMicros(20);\n        pins.digitalWritePin(pin, 0);\n        duration = pins.pulseIn(pin, PulseValue.High, 100000); // Max duration 100 ms\n\n        RangeInInches = duration * 153 / 74 / 2 / 100;\n\n        if (RangeInInches > 0) distanceBackup = RangeInInches;\n        else RangeInInches = distanceBackup;\n\n        basic.pause(50);\n\n        return RangeInInches;\n    }\n\n\n\n}\n"}]},{"timestamp":1794992136340,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":1115,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"></block><block type=\"device_forever\" x=\"39\" y=\"121\"><statement name=\"HANDLER\"><block type=\"controls_if\"><value name=\"IF0\"><shadow type=\"logic_boolean\" disabled-reasons=\"pxt_automatic_disabled\"><field name=\"BOOL\">TRUE</field></shadow><block type=\"logic_compare\"><field name=\"OP\">LT</field><value name=\"A\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"grove_ultrasonic_centimeters_v2\"><field name=\"pin\">DigitalPin.P0</field></block></value><value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">25</field></shadow></value></block></value><statement name=\"DO0\"><block type=\"device_ring\"><value name=\"note\"><shadow type=\"device_note\"><field name=\"name\">262</field></shadow></value></block></statement></block></statement></block></xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":28,"length1":151,"diffs":[[1,"    if (GROVE.measureInCentimetersV2(DigitalPin.P0) < 25) {\n        music.ringTone(262)\n"]]},{"start1":122,"length1":22,"diffs":[[1,""]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":2,"length1":25,"